{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "keepnote",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // マイグレーション SQL を Worker に同梱する（起動時に未適用分を自動で適用）
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // 公開する URL。パスキーは 1 つのドメインに紐づくため、カスタムドメインだけで公開する（自分のドメインに書き換える）
  "routes": [{ "pattern": "notes.example.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // フロントエンド（Vite のビルド結果）。/api/* 以外は静的アセットとして配信し、SPA のルーティングに対応
  "assets": {
    "directory": "./dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/share-target"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keepnote",
      // `npx wrangler d1 create keepnote` で表示される database_id に書き換える
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // リアルタイム共同編集の部屋（ページごと）
  "durable_objects": { "bindings": [{ "name": "PAGE_ROOM", "class_name": "PageRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PageRoom"] }],

  // 添付ファイルの保存先（`npx wrangler r2 bucket create keepnote-files` で作る）
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "keepnote-files" }],

  // 認証 API のレート制限（IP ごとに 60 秒あたり 40 回）
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 40, "period": 60 } }
  ],

  // 期限切れセッション等の掃除
  "triggers": { "crons": ["0 */6 * * *", "*/10 * * * *"] },

  "vars": {
    // ブラウザでアクセスする URL（routes と同じドメイン）。パスキーはこのドメインに紐づく（変更すると登録済みパスキーは使えなくなる）
    "ORIGIN": "https://notes.example.com"
  },

  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
