# ブラウザからアクセスする公開URL（末尾スラッシュなし）。パスキーはこの値に紐づくため正確に設定すること。
# localhost 以外では HTTPS が必須です。
ORIGIN=https://notes.example.com

# パスキーの RP ID（通常は ORIGIN のホスト名。省略可）
# RP_ID=notes.example.com

# リバースプロキシ配下で実際のクライアントIPを記録する場合は true
TRUST_PROXY=true

# 初回起動時に作成される管理者のユーザー名
ADMIN_USERNAME=admin

# アップロード上限（MB）
MAX_UPLOAD_MB=20

PORT=3000
