{
  "name": "keepnote",
  "version": "1.0.0",
  "description": "パスキーでログインする、セルフホスト型のノート・ドキュメントワークスペース",
  "scripts": {
    "dev": "concurrently -k -n worker,web -c blue,green \"wrangler dev --port 8790 --local-upstream localhost:5173\" \"vite\"",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "cli": "node src/server/cli.ts",
    "cli:local": "node src/server/cli.ts --d1 local",
    "cli:remote": "node src/server/cli.ts --d1 remote",
    "dev:local": "concurrently -k -n api,web -c blue,green \"DEV_LOGIN=1 DATA_DIR=./data-dev PORT=3002 ORIGIN=http://localhost:5174 node --watch src/server/node.ts\" \"API_PORT=3002 vite --mode node --port 5174\"",
    "seed:dev": "node scripts/seed-dev.ts",
    "dev:node": "concurrently -k -n api,web -c blue,green \"PORT=3000 node --watch src/server/node.ts\" \"vite --mode node\"",
    "start:node": "NODE_ENV=production node src/server/node.ts",
    "backup:decrypt": "node src/server/decrypt-backup.ts",
    "icons": "python3 scripts/build-ui-icons.py"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@hono/node-server": "^2.1.6",
    "@simplewebauthn/server": "^14.0.3",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "fflate": "^0.8.2",
    "hono": "^4.13.16",
    "katex": "^0.19.1",
    "mammoth": "^1.12.3",
    "material-symbols": "^0.48.3",
    "pdfjs-dist": "^6.5.438",
    "prosemirror-inputrules": "^1.5.1",
    "qrcode-generator": "^1.4.4",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@blocknote/core": "^0.57.0",
    "@blocknote/mantine": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.15",
    "@mantine/core": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@simplewebauthn/browser": "^14.0.0",
    "@tiptap/pm": "^3.33.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "prosemirror-state": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.157.0"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
